	<!--		       vs.date_created as createAt,-->
	<!--		       f.path          as path,-->
	<!--		       c.state         as state-->
	<!--		FROM t_virtual_surgery vs-->
	<!--			     JOIN t_files f ON vs.virtual_file_group_id = f.group_id-->
