	<!--		WHERE vs.user_id = #{userId}-->
	<!--		ORDER BY vs.date_created-->
	<!--		LIMIT #{size} OFFSET #{page} * 10;-->
	<!--	</select>-->

	<delete id="deleteVirtualSurgeryById" parameterType="long">
		DELETE
		FROM t_virtual_surgery
		WHERE id = #{virtualId}
	</delete>

	<select id="countAllByUserId" parameterType="Map">
		SELECT COUNT(*)
		FROM t_virtual_surgery
		WHERE user_id = #{userId};
	</select>

	<resultMap id="virtualSurgeryWithCounsel" type="com.wannabe.app.main.data.dto.virutality.GetMyVirtualSurgeryDto">
		<id column="id" property="id"/>
		<result column="createAt" property="createAt" typeHandler="com.wannabe.app.main.utility.mybatis.LocalDateTimeHandler"/>
		<result column="state" property="state"/>
		<result column="thumbNail" property="thumbNail"/>
	</resultMap>

	<select id="findCounselByUserId" parameterType="Map" resultMap="virtualSurgeryWithCounsel">
		SELECT vs.id           AS id,
		       vs.date_created AS createAt,
		       c.state         AS state,
		       t.path          AS thumbNail
		FROM t_virtual_surgery vs
			     LEFT JOIN (SELECT DISTINCT ON (virtual_id) *
			                FROM t_counsel
			                ORDER BY virtual_id, date_created) c ON vs.id = c.virtual_id
			     LEFT JOIN t_files t ON vs.original_file_group_id = t.group_id
		WHERE vs.user_id = #{userId}
		LIMIT #{size} OFFSET #{page} * 10;
	</select>
</mapper>