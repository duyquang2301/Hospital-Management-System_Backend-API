<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wannabe.app.main.mapper.ChattingMapper">
    <resultMap id="Chatting" type="com.wannabe.app.main.data.entity.Chatting">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="subject_user_id" property="subjectUserId"/>
        <result column="firebase_key" property="firebaseKey"/>
        <result column="date_created" property="createdAt" typeHandler="com.wannabe.app.main.utility.mybatis.LocalDateTimeHandler"/>
    </resultMap>

    <resultMap id="Block" type="com.wannabe.app.main.data.entity.Block">
        <result column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="subject_user_id" property="subjectUserId"/>
        <result column="date_created" property="createdAt" typeHandler="com.wannabe.app.main.utility.mybatis.LocalDateTimeHandler"/>
    </resultMap>

    <select id="findChattingByUserIds" parameterType="long" resultMap="Chatting">
        SELECT *
        FROM t_chatting
        WHERE (user_id = #{userId} AND subject_user_id = #{subjectUserId})
           OR (user_id = #{subjectUserId} AND subject_user_id = #{userId});
    </select>

    <select id="findChattingByChatId" parameterType="long" resultMap="Chatting">
        SELECT *
        FROM t_chatting
        WHERE id = #{chatId};
    </select>

    <select id="increaseChattingSeq" resultType="long">
        SELECT nextval('CHATTING_ID_SEQ');
    </select>

    <insert id="insertChatting" parameterType="com.wannabe.app.main.data.entity.Chatting">
        INSERT INTO t_chatting (id, user_id, subject_user_id, firebase_key)
        VALUES (#{id}, #{userId}, #{subjectUserId}, #{firebaseKey});
    </insert>

    <select id="findBlockUserIdListByUserId" parameterType="long" resultType="long">
        SELECT subject_user_id
        FROM t_block
        WHERE user_id = #{userId};
    </select>

    <select id="findChattingListByUserId" parameterType="long" resultMap="Chatting">
        SELECT *
        FROM t_chatting
        WHERE user_id = #{userId}
           OR subject_user_id = #{userId};
    </select>

    <select id="insertBlock" parameterType="com.wannabe.app.main.data.entity.Block">
        INSERT INTO t_block (user_id, subject_user_id)
        VALUES (#{userId}, #{subjectUserId});
    </select>

    <delete id="deleteBlock" parameterType="com.wannabe.app.main.data.entity.Block">
        DELETE FROM t_block
        WHERE user_id = #{userId}
          AND subject_user_id = #{subjectUserId};
    </delete>
</mapper>